def resolve_env_file() -> tuple[Path | None, bool]:
    """Return (path, is_override).

    is_override=True means the operator explicitly set
    SWARM_REVIEW_ENV_FILE. The caller MUST die() on a missing or
    unreadable override rather than silently skipping — silent skip
    would let a typo'd override fall through to the cursor-only path
    and only surface later as a missing-API-key error.

    is_override=False means we either found a default candidate or
    nothing exists. Defaults are silent-on-missing because the cursor
    backend doesn't need API keys at all.
    """
    override = os.environ.get("SWARM_REVIEW_ENV_FILE")
    if override:
        return Path(override), True
    for p in DEFAULT_ENV_FILES:
        if p.exists():
            return p, False
    return None, False

