def reviewer_timeout(name: str, cfg: dict, cli_override: int | None) -> int:
    """Resolve the effective per-reviewer timeout.

    Precedence (highest first):
      1. --timeout on the CLI         — explicit operator intent wins
                                        over any environment state (a
                                        stale TIMEOUT_GEMINI=300 in the
                                        operator's shell must not
                                        silently override `--timeout 60`)
      2. SWARM_REVIEW_TIMEOUT_<NAME>  — per-reviewer env override
      3. SWARM_REVIEW_TIMEOUT          — global env override
      4. cfg["timeout"]               — per-reviewer baseline
      5. 180                          — last-resort fallback
    """
    def _parse(val: str | None) -> int | None:
        if val is None:
            return None
        try:
            n = int(val)
            return n if n > 0 else None
        except ValueError:
            return None

    if cli_override is not None and cli_override > 0:
        return cli_override
    if v := _parse(os.environ.get(f"SWARM_REVIEW_TIMEOUT_{name.upper()}")):
        return v
    if v := _parse(os.environ.get("SWARM_REVIEW_TIMEOUT")):
        return v
    return cfg.get("timeout", 180)

